{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "thermal-lab",
  "version": "0.1.0",
  "identifier": "dev.sebaj.thermal-lab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Thermal Lab",
        "width": 460,
        "height": 610,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFQjExMTQxMTgxNTkwNEIKUldSTGtCVVlRUkd4YmtPcGFZZVh5VEZNQTVzWmE1Q1dYOG9JZWg0S3hYbnRacFY3U0dydmFCZjEK",
      "endpoints": [
        "https://github.com/Sebajuste/thermal-lab/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
